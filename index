                    <div>
                        <div class="inline-flex items-center gap-2 bg-white/15 border border-white/20 text-gold px-3 py-0.5 rounded-full">
                            <span class="w-2 h-2 rounded-full bg-gold animate-pulse"></span>
                            <span class="text-[10px] sm:text-[11px] font-extrabold uppercase tracking-wider">Welcome To English Education Portal • SMP/MTs Fase D</span>
                        </div>
                        <h1 class="font-display font-extrabold text-2xl sm:text-3xl text-white tracking-tight mt-1.5">
                            English For <span class="text-gold">Nusantara</span>
