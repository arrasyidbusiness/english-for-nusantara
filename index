                            <button type="button" id="st-tab-reg" onclick="switchStudentTab('reg')" class="py-2 rounded-xl text-xs font-bold text-navy-muted cursor-pointer transition">Daftar Siswa Mandiri</button>
                        </div>

                        <form id="form-student-login" onsubmit="handleStudentLogin(event)" class="space-y-3.5">
                            <div>
                                <label class="block text-xs font-bold text-navy mb-1">Kode Kelas dari Guru <span class="text-slate-400 font-normal">(Isi jika membuka dari HP/perangkat lain)</span></label>
                                <input type="text" id="login-st-code" placeholder="Contoh: EFN-IXA26" class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm uppercase font-bold text-royal bg-cream-soft focus:outline-royal">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-navy mb-1">Nama Lengkap Siswa *</label>
                                <input type="text" id="login-st-name" required placeholder="Ketik nama lengkap Anda..." class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm bg-white focus:outline-royal">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-navy mb-1">PIN Siswa *</label>
                                <input type="password" id="login-st-pin" required placeholder="1234" class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm bg-white focus:outline-royal">
                            </div>
                            <button type="submit" id="btn-st-login" class="w-full bg-royal hover:bg-royal-hover text-white font-display font-extrabold text-sm py-3.5 rounded-2xl shadow-md transition cursor-pointer flex items-center justify-center gap-2 mt-2">
                                <span>Masuk ke Ruang Siswa</span>
                                <i data-lucide="arrow-right" class="w-4 h-4"></i>
                            </button>
                        </form>

