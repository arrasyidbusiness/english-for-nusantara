                            </div>
                            <div>
                                <label class="block text-xs font-bold text-navy mb-1">Nama Lengkap Siswa *</label>
                                <input type="text" id="reg-st-name" required placeholder="Nama lengkap sesuai absen..." class="w-full border border-slate-300 rounded-xl px-3.5 py-2 text-xs">
