                                <input type="text" id="reg-st-code" placeholder="Contoh: EFN-IXA26" class="w-full border border-slate-300 rounded-xl px-3.5 py-2 text-xs uppercase font-bold text-royal bg-cream-soft">
                            </div>
                            <div>
